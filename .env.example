# Copy to .env and change for anything beyond local dev.
# Read by docker compose, ecosystem.config.js (PM2) and the systemd unit.

# Broker and database containers
RABBITMQ_ADMIN_USER=admin
RABBITMQ_ADMIN_PASS=admin
POSTGRES_DB=telemetry
POSTGRES_USER=ingest
POSTGRES_PASSWORD=ingest

# Ingest service (python -m ingest)
DATABASE_URL=postgresql://ingest:ingest@localhost:5432/telemetry
AMQP_HOST=localhost
AMQP_PORT=5672
AMQP_USER=ingest
AMQP_PASSWORD=ingest
LOG_LEVEL=INFO

# Admin CLI (python -m ingest.admin)
RABBITMQ_API_URL=http://localhost:15672/api

# systemd unit: an alternative to PM2 for starting the ingest service on boot.
#
#   sudo cp deploy/intellify-ingest.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now intellify-ingest
#   journalctl -u intellify-ingest -f
#
# Assumes the repo is at /opt/intellify with its .venv and .env, run as user
# `intellify`. Adjust the paths below otherwise.

[Unit]
Description=Intellify telemetry ingestion (RabbitMQ AMQP -> PostgreSQL)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
User=intellify
WorkingDirectory=/opt/intellify
EnvironmentFile=/opt/intellify/.env
ExecStart=/opt/intellify/.venv/bin/python -m ingest
# The service also retries internally, so a broker or database that starts
# later is picked up without a restart.
Restart=always
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
